<!doctype html>
<html lang="en">
<head>
{% include "head.njk" %}
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css?v={{ build.version }}">
<script src="/assets/nav.js?v={{ build.version }}" defer></script>
{%- if page.url == "/" %}
<script type="application/ld+json">{{ site | personJsonLd | safe }}</script>
{%- elif p and (p | projectJsonLd) %}
<script type="application/ld+json">{{ p | projectJsonLd | safe }}</script>
{%- endif %}
</head>
<body>
<div class="console">
  <div class="bezel">
    <div class="label pixel"><span>KARTIK LUKE SINGH</span> <span class="loc">· BANGALORE, IN</span></div>
    <div class="bay">
      <div class="power" aria-hidden="true"><span class="led{% if lowBattery %} low{% endif %}"></span><span>{{ "LOW BATT" if lowBattery else "POWER" }}</span></div>
      <main class="screen{% if dimScreen %} dim{% endif %}">
{{ content | safe }}
      </main>
    </div>
    <div class="wordmark pixel" aria-hidden="true">{% include "wordmark.njk" %}</div>
  </div>
  <div class="speaker" aria-hidden="true">{% for i in range(24) %}<span></span>{% endfor %}</div>
</div>
<nav class="pad" aria-label="Game Boy controls">
  <div class="dpad">
    <button tabindex="-1" class="d up" data-pad="up" aria-label="Up"></button>
    <button tabindex="-1" class="d left" data-pad="left" aria-label="Previous"></button>
    <span class="d mid" aria-hidden="true"></span>
    <button tabindex="-1" class="d right" data-pad="right" aria-label="Next"></button>
    <button tabindex="-1" class="d down" data-pad="down" aria-label="Down"></button>
  </div>
  <div class="sys">
    <button tabindex="-1" data-pad="select" aria-label="Writing"><span class="pill-btn"></span><span class="lbl">SELECT</span></button>
    <button tabindex="-1" data-pad="start" aria-label="Home"><span class="pill-btn"></span><span class="lbl">START</span></button>
  </div>
  <div class="ab">
    <button tabindex="-1" class="b" data-pad="b" aria-label="Back"><span class="btn"></span><span class="lbl">B</span></button>
    <button tabindex="-1" class="a" data-pad="a" aria-label="Open"><span class="btn"></span><span class="lbl">A</span></button>
  </div>
</nav>
</body>
</html>
